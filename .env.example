# ==============================================================================
# Beer Empire Environment Variables Template
# Copy this file to `.env` and fill in the required values.
# ==============================================================================

# Telegram Bot Token (obtain from BotFather)
# Required for running the Telegram Bot component
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# PostgreSQL database asyncpg connection URL
# Used by SQLAlchemy to connect to the database
# Default for Docker Compose is: postgresql+asyncpg://postgres:postgres@db:5432/beer_empire
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/beer_empire

# Google Gemini API Key (optional)
# Required for running LLM event worker. If omitted, fallback dummy events are generated.
LLM_API_KEY=your_gemini_api_key_here

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Default is INFO
LOG_LEVEL=INFO

# ==============================================================================
# Database Configuration (Used by Docker Compose)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=beer_empire
